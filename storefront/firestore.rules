rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /giftcards/{doc} {
      allow read, write: if request.auth != null;
    }
    match /users/{doc} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /clientes/{doc} {
      allow read, write: if request.auth != null;
    }
    match /categorias/{doc} {
      allow read, write: if request.auth != null;
    }
    match /config/{doc} {
      allow read, write: if request.auth != null;
    }

    // ── Storefront público (BaalShop Recargas) ──
    match /catalogo/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /pedidos/{doc} {
      allow read, update, delete: if request.auth != null;
      allow create: if request.auth == null
        && request.resource.data.status == 'pendente'
        && request.resource.data.origem == 'storefront'
        && request.resource.data.desc is string
        && request.resource.data.clienteNome is string
        && request.resource.data.valor is number;
    }
  }
}
